# Server Environment
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_helpdesk
JWT_SECRET=helpdesk_jwt_super_secure_secret_key_minimum_32_chars_2026
JWT_EXPIRES_IN=7d

# OpenAI LLM Configuration (Optional: fallback offline simulator is used if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Redis / BullMQ Configuration (Optional: in-memory async fallback worker is used if omitted)
REDIS_URL=redis://127.0.0.1:6379

# File Storage Configuration
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760
